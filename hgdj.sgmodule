#!name=红果短剧去广告
#!desc=Qj521 Surge-Script 新库修复版，修复时不时失效问题
#!author=Qj521 Fix
#!homepage=https://github.com/Qj521/Surge-Script
#!icon=play.tv.fill

[Script]
# 新库核心地址，指向 Surge-Script 仓库，不是原来的 Loon 了
红果短剧 请求 = type=http-request,pattern=^https?://.*(hongguo|hjapi|hg-api|snssdk|byteoversea).* ,script-path=https://raw.githubusercontent.com/Qj521/Surge-Script/main/hgdj/hgdj.js,requires-body=true,timeout=20
红果短剧 响应 = type=http-response,pattern=^https?://.*(hongguo|hjapi|hg-api|snssdk|byteoversea).* ,script-path=https://raw.githubusercontent.com/Qj521/Surge-Script/main/hgdj/hgdj.js,requires-body=true,timeout=20

[Rule]
DOMAIN-SUFFIX,ad.pangle.cn,REJECT
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT
DOMAIN-SUFFIX,hongguosdk.com,REJECT
DOMAIN-KEYWORD,zijieapi,REJECT
DOMAIN-SUFFIX,hongguo.com,DIRECT
DOMAIN-SUFFIX,snssdk.com,DIRECT

[Rewrite]
^https?:\/\/.+\.pangolin-sdk-toutiao\.com\/api\/ad\/.* url reject
^https?:\/\/.+\.snssdk.com\/api\/ad\/.+ url reject

[MITM]
hostname = %APPEND% *.hongguo.com, *.hjapi.com, *.hg-api.com, *.snssdk.com, *.byteoversea.com, *.pangolin-sdk-toutiao.com