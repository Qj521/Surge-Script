#!name=解锁检测 Fix
#!desc=Surge 专用修复版
#!author=Fix by AI

[Panel]
解锁检测 = script-name=BlockCheck, title="解锁检测", content="正在检测...", style=info, script-path=https://raw.githubusercontent.com/RavelloH/Block-Check/main/block_check.js

[Script]
BlockCheck = type=generic, timeout=20, script-path=https://raw.githubusercontent.com/RavelloH/Block-Check/main/block_check.js, argument=title=解锁检测&icon=star.fill

[MITM]
hostname = %APPEND% www.youtube.com, www.netflix.com, disney.api.edge.bamgrid.com, api.openai.com